generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  OPERATOR
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Clinic {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  address   String?
  users     User[]
  customers Customer[]
  services  Service[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  email     String   @unique
  role      UserRole
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

model Customer {
  id           String             @id @default(cuid())
  clinicId     String
  name         String
  phone        String
  dateOfBirth  DateTime?
  gender       Gender?
  notes        String?
  clinic       Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  packages     Package[]
  appointments Appointment[]
  treatments   TreatmentSession[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([clinicId])
  @@index([phone])
}

model Service {
  id           String    @id @default(cuid())
  clinicId     String
  name         String
  description  String?
  defaultPrice Decimal   @db.Decimal(12, 2)
  active       Boolean   @default(true)
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  packages     Package[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clinicId])
}

model Package {
  id            String             @id @default(cuid())
  customerId    String
  serviceId     String
  totalSessions Int
  price         Decimal            @db.Decimal(12, 2)
  purchaseDate  DateTime
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service       Service            @relation(fields: [serviceId], references: [id])
  treatments    TreatmentSession[]
  appointments  Appointment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([customerId])
  @@index([serviceId])
}

model TreatmentSession {
  id            String   @id @default(cuid())
  customerId    String
  packageId     String
  sessionNumber Int
  treatmentDate DateTime
  notes         String?
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package       Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([packageId, sessionNumber])
  @@index([customerId])
  @@index([packageId])
}

model Appointment {
  id          String            @id @default(cuid())
  customerId  String
  packageId   String?
  scheduledAt DateTime
  status      AppointmentStatus @default(PENDING)
  notes       String?
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package     Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([customerId])
  @@index([scheduledAt])
  @@index([status])
}
